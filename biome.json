{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!out",
      "!dist",
      "!resources",
      "!src/main/icon-png.ts",
      "!src/main/tray-png.ts",
      "!src/renderer/src/components/crew-mark.ts",
      "!pdfjs-assets.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "noLabelWithoutControl": "off",
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off",
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "noExtraBooleanCast": "off",
        "noImportantStyles": "off",
        "noUselessContinue": "off",
        "noUselessFragments": "off",
        "noUselessStringRaw": "off",
        "noUselessThisAlias": "off",
        "noUselessUndefinedInitialization": "off",
        "useArrowFunction": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "useRegexLiterals": "off"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noConstructorReturn": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedVariables": "error",
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off",
        "noGlobalEval": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useConst": "off",
        "useExponentiationOperator": "off",
        "useImportType": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "off",
        "noFocusedTests": "off",
        "noGlobalIsFinite": "off",
        "noMisleadingCharacterClass": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
