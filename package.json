{
  "name": "crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "crew": "bin/crew.mjs"
  },
  "build": {
    "appId": "com.jamel.crew",
    "productName": "Crew",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "cli/bin"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/@koromix/koffi-*/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JamelHammoud",
        "repo": "crew"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "So you can talk in a huddle, and dictate with Scribe.",
        "NSCameraUsageDescription": "So the crew can see you in a huddle.",
        "NSLocalNetworkUsageDescription": "So you can reach a crew on this network.",
        "NSAppleEventsUsageDescription": "So dictation lands in the box you are typing in.",
        "NSDesktopFolderUsageDescription": "So you can open a project kept there.",
        "NSDocumentsFolderUsageDescription": "So you can open a project kept there.",
        "NSDownloadsFolderUsageDescription": "So you can open a project kept there.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Code document",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeOSTypes": [
              "TEXT",
              "utxt",
              "TUTX",
              "****"
            ],
            "CFBundleTypeExtensions": [
              "h",
              "c",
              "gitattributes",
              "gitconfig",
              "gitignore",
              "asp",
              "aspx",
              "cshtml",
              "jshtm",
              "jsp",
              "phtml",
