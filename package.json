    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code": "3.29.2",
