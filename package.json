            ],
            "CFBundleTypeIconFile": "icon.icns"
          },
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeOSTypes": [
              "TEXT",
              "utxt",
              "TUTX",
              "****"
            ],
            "CFBundleTypeExtensions": [],
            "LSItemContentTypes": [
              "public.folder"
            ],
            "CFBundleTypeIconFile": "icon.icns"
          }
        ]
      }
    },
    "dmg": {
      "title": "Crew",
      "background": "resources/dmg-background.png",
      "window": {
        "width": 660,
        "height": 400
      },
      "iconSize": 128,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 172,
          "y": 206,
          "type": "file"
        },
        {
          "x": 488,
          "y": 206,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "icon": "resources/icon.png"
    }
  },
  "scripts": {
    "dev": "node scripts/name-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "CREW_SHIPPING_ICON=1 electron-vite preview",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format --changed --no-errors-on-unmatched .",
    "media-check": "node scripts/media-check.mjs",
    "voice-check": "node scripts/voice-check.mjs",
    "mouth-check": "node scripts/mouth-check.mjs",
    "selection-check": "node scripts/selection-check.mjs",
    "file-editor-check": "node scripts/file-editor-check.mjs",
    "typing-check": "node scripts/typing-check.mjs",
    "board-check": "node scripts/board-check.mjs",
    "design-header-look": "node scripts/design-header-look.mjs",
    "docs-look": "node scripts/docs-look.mjs",
    "doc-bullets-look": "node scripts/doc-bullets-look.mjs",
    "doc-numbers-look": "node scripts/doc-numbers-look.mjs",
    "doc-click-look": "node scripts/doc-click-look.mjs",
    "doc-tables-look": "node scripts/doc-tables-look.mjs",
    "doc-code-look": "node scripts/doc-code-look.mjs",
    "agent-look": "node scripts/agent-look.mjs",
    "agent-motion-look": "node scripts/agent-motion-look.mjs",
    "avatar-look": "node scripts/avatar-look.mjs",
    "agent-modal-check": "node scripts/agent-modal-check.mjs",
    "card-look": "node scripts/card-look.mjs",
    "tray-look": "node scripts/tray-look.mjs",
    "thread-card-look": "node scripts/thread-card-look.mjs",
    "plus-look": "node scripts/plus-look.mjs",
    "composer-look": "node scripts/composer-look.mjs",
    "queue-look": "node scripts/queue-look.mjs",
    "personal-chat-look": "node scripts/personal-chat-look.mjs",
    "stickies-look": "node scripts/stickies-look.mjs",
    "board-perf": "node scripts/board-perf.mjs",
    "snap-check": "node scripts/snap-check.mjs",
    "scribe-check": "node scripts/scribe-check.mjs",
    "scribe-edit-check": "node scripts/scribe-edit-check.mjs",
    "scribe-caret-check": "node scripts/scribe-caret-check.mjs",
    "preview-check": "node scripts/preview-check.mjs",
    "scrim-check": "node scripts/scrim-check.mjs",
    "codex-check": "node scripts/codex-check.mjs",
    "goal-check": "node scripts/goal-check.mjs",
    "kimi-check": "node scripts/kimi-check.mjs",
    "gemini-check": "node scripts/gemini-check.mjs",
    "local-check": "node scripts/local-check.mjs",
    "dist": "electron-vite build && electron-builder",
    "icon": "node scripts/make-icon.mjs",
    "dmg-preview": "node scripts/dmg-preview.mjs",
    "dmg-check": "node scripts/dmg-check.mjs",
    "icons": "node scripts/icon-sheet.mjs",
    "mark-check": "node scripts/mark-check.mjs",
    "covers": "node scripts/cover-sheet.mjs",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-pty.mjs && node scripts/name-electron.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "node-pty": "1.1.0",
    "rbush": "^3.0.1",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
